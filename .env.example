APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

ONEC_EXCHANGE_USER=
ONEC_EXCHANGE_PASSWORD=
ONEC_EXCHANGE_FILE_LIMIT=10485760
ONEC_EXCHANGE_MAX_FILE_SIZE=536870912
ONEC_EXCHANGE_FILE_RETENTION_HOURS=48

# ===== ВАТС A1 =====
# Секрет генерируется на сервере и добавляется в URL Webhook. Не отправляйте его в чат/логи.
A1_TELEPHONY_WEBHOOK_SECRET=
A1_TELEPHONY_BASE_URL=https://vats.a1.by/crm-api/open-api/v1
A1_TELEPHONY_TIMEZONE=Europe/Minsk
A1_TELEPHONY_HISTORY_LOOKBACK=15

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Служебные письма: создание пароля и восстановление доступа.
# Создайте ящик no-reply@kotlov.by и храните пароль только в переменных окружения сервера.
TRANSACTIONAL_MAIL_SCHEME=smtps
TRANSACTIONAL_MAIL_HOST=smtp.hoster.by
TRANSACTIONAL_MAIL_PORT=465
TRANSACTIONAL_MAIL_USERNAME=no-reply@kotlov.by
TRANSACTIONAL_MAIL_PASSWORD=
TRANSACTIONAL_MAIL_FROM_ADDRESS=no-reply@kotlov.by
TRANSACTIONAL_MAIL_FROM_NAME="KOTLOV.BY"
B2B_NOTIFICATION_EMAIL="order@kotlov.by"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram: отдельный чат онлайн-консультаций или fallback на канал заявок/заказов.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDERS_CHAT_ID=
TELEGRAM_CONTACT_REQUESTS_CHAT_ID=
TELEGRAM_SUPPORT_CHAT_ID=

# ===== ИИ и живое исследование рынка =====
AI_API_KEY=
AI_API_URL=
AI_MODEL=deepseek-chat
AI_SUPPORT_CHAT_TIMEOUT=12
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_RESEARCH_MODEL=gpt-6.1-sol
OPENAI_RESEARCH_TIMEOUT=180
# Необязательно: собственный доверенный HTTP(S) CONNECT-proxy для исходящих запросов OpenAI.
OPENAI_PROXY=
# Пример: http://user:password@gateway.example:3128

# Исследование рынка со встроенным web search. По умолчанию использует тот же AI_API_KEY.
MARKET_RESEARCH_PROVIDER=deepseek
DEEPSEEK_ANTHROPIC_URL=https://api.deepseek.com/anthropic/v1/messages
DEEPSEEK_RESEARCH_MODEL=deepseek-v4-pro
DEEPSEEK_RESEARCH_FALLBACK_MODEL=deepseek-flash
MARKET_RESEARCH_SAFE_MODE=true
MARKET_RESEARCH_MAX_SEARCH_USES=6
MARKET_RESEARCH_MAX_OUTPUT_TOKENS=8000
MARKET_RESEARCH_CACHE_MINUTES=360

# Необязательные резервные провайдеры: openai или azure.
MARKET_OPENAI_PROVIDER=deepseek
AZURE_OPENAI_API_KEY=
# Пример: https://RESOURCE.openai.azure.com/openai/v1/responses
AZURE_OPENAI_RESPONSES_URL=
# Имя deployment в Azure, а не обязательно исходное имя модели.
AZURE_OPENAI_RESEARCH_MODEL=gpt-5.5

# ===== Защита публичных форм от спама =====
FORM_TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ===== Поиск фото товаров (supplier:enrich-images) =====
# Достаточно настроить ОДИН провайдер. Используется только этой командой.
SERPER_API_KEY=
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=
# BING_IMAGE_KEY=

# ===== Обогащение реквизитов белорусских компаний по УНП =====
# Учётная запись API https://contragento.by/api
BELARUS_COMPANY_REGISTRY_URL=https://api.contragento.by/api/check
BELARUS_COMPANY_REGISTRY_USERNAME=
BELARUS_COMPANY_REGISTRY_PASSWORD=
