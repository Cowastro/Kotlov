APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

ONEC_EXCHANGE_USER=
ONEC_EXCHANGE_PASSWORD=
ONEC_EXCHANGE_FILE_LIMIT=10485760
ONEC_EXCHANGE_MAX_FILE_SIZE=536870912
ONEC_EXCHANGE_FILE_RETENTION_HOURS=48

# ===== ВАТС A1 =====
# Секрет генерируется на сервере и добавляется в URL Webhook. Не отправляйте его в чат/логи.
A1_TELEPHONY_WEBHOOK_SECRET=
A1_TELEPHONY_BASE_URL=https://vats.a1.by/crm-api/open-api/v1
A1_TELEPHONY_TIMEZONE=Europe/Minsk
A1_TELEPHONY_HISTORY_LOOKBACK=15

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== Защита публичных форм от спама =====
FORM_TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ===== Поиск фото товаров (supplier:enrich-images) =====
# Достаточно настроить ОДИН провайдер. Используется только этой командой.
SERPER_API_KEY=
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=
# BING_IMAGE_KEY=

# ===== Обогащение реквизитов белорусских компаний по УНП =====
# Учётная запись API https://contragento.by/api
BELARUS_COMPANY_REGISTRY_URL=https://api.contragento.by/api/check
BELARUS_COMPANY_REGISTRY_USERNAME=
BELARUS_COMPANY_REGISTRY_PASSWORD=
