RewriteEngine On

# Serve crawler policy without PHP, sessions or MySQL on the primary/admin hosts.
# City hosts retain their existing branch-aware robots policy in Laravel.
RewriteCond %{HTTP_HOST} ^(?:www\.|new\.)?kotlov\.by(?::[0-9]+)?$ [NC]
RewriteRule ^robots\.txt$ public/seo/robots-main.txt [L]
RewriteCond %{HTTP_HOST} ^admin\.kotlov\.by(?::[0-9]+)?$ [NC]
RewriteRule ^robots\.txt$ public/seo/robots-admin.txt [L]

# Legacy crawlable city links are retired. The POST selector creates a signed
# short-lived GET handoff when crossing hosts. Reject old links before PHP/MySQL.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{QUERY_STRING} !(^|&)signature=[0-9a-f]{64}(&|$) [NC]
RewriteRule ^(?:public/)?city/select/[^/]+/?$ - [G,L]

# Убираем trailing slash — всегда на HTTPS
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ https://%{HTTP_HOST}/%1 [L,R=301]

# Редирект www → без www
RewriteCond %{HTTP_HOST} ^www\.kotlov\.by$ [NC]
RewriteRule ^ https://kotlov.by%{REQUEST_URI} [L,R=301]

# Всё остальное → public/
RewriteRule ^(.*)$ public/$1 [L]
