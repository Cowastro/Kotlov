RewriteEngine On

# HTTP → HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Убираем trailing slash — всегда на HTTPS
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ https://kotlov.by/%1 [L,R=301]

# Редирект www → без www
RewriteCond %{HTTP_HOST} ^www\.kotlov\.by$ [NC]
RewriteRule ^ https://kotlov.by%{REQUEST_URI} [L,R=301]

# Всё остальное → public/
RewriteRule ^(.*)$ public/$1 [L]
