# Legacy rsynced product photos (18k+ files, never committed) — must stay
# untouched by `git stash --include-untracked` in the server-artisan-queue
# workflow. Without this, stash -u sweeps it up and it silently vanishes
# from the working tree on every queued task run.
/public/images/

# Same reasoning — supplier/enrichment commands download these directly on
# the server and never commit them. Untracked + not ignored means every
# server-artisan-queue run's `git stash -u` sweeps them into stash and they
# vanish from the working tree until recovered.
/public/img/brands/teplodvor/
/public/img/products/belkomin-tis/
/public/img/products/ecokamin/
/public/img/products/elicon/
/public/docs/suppliers/gorodkotlov/vaillant/
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Supplier pricelists — Excel files, CSV reports and mapping drafts are never committed
/storage/app/pricelists/*.xlsx
/storage/app/pricelists/*.xls
/storage/app/pricelists/reports/
/storage/app/pricelists/mappings/
!/storage/app/pricelists/.gitkeep

