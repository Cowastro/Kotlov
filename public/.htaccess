<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ── Блокируем агрессивных AI/SEO-скрейперов ─────────────────────────
    # 403 на уровне Apache, до запуска PHP. Реальным посетителям и
    # Google/Bing/Yandex не мешает. Если что-то ломает индексацию —
    # достаточно убрать конкретного бота из списка.
    RewriteCond %{HTTP_USER_AGENT} (SemrushBot|GPTBot|GeedoShop|PetalBot|AhrefsBot|MJ12bot|DotBot|DataForSeoBot|ClaudeBot|Claude-Web|Bytespider|CCBot|Amazonbot|FacebookBot|Applebot-Extended|anthropic-ai|cohere-ai|Diffbot|ImagesiftBot|Omgilibot|Omgili|Timpibot|YouBot|ZoominfoBot) [NC]
    RewriteRule .* - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Картинки старого сайта: файл уже скопирован в public/images —
    # отдаём статикой, не запуская PHP (docroot может быть корнем проекта или public/)
    RewriteCond %{DOCUMENT_ROOT}/public/images/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/images/$1 -f
    RewriteRule ^proxy-image/(.+)$ images/$1 [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Браузерный кеш для статики (раньше был только ETag — браузер перепроверял каждый файл)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg  "access plus 30 days"
    ExpiresByType image/png   "access plus 30 days"
    ExpiresByType image/gif   "access plus 30 days"
    ExpiresByType image/webp  "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon  "access plus 30 days"
    ExpiresByType font/woff   "access plus 30 days"
    ExpiresByType font/woff2  "access plus 30 days"
    ExpiresByType text/css        "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
